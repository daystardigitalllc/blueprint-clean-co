---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Marquee from '../components/Marquee.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { Image } from 'astro:assets';
import { site, trustTicker } from '../lib/site';
import heroImg from '../assets/photos/lived-in-kitchen-clean.jpg';
import deepImg from '../assets/photos/residential-kitchen-clean.jpg';
import recurringImg from '../assets/photos/lived-in-bathroom-clean.jpg';
import moveImg from '../assets/photos/empty-living-room-clean.jpg';
import listingImg from '../assets/photos/hero-living-room-1.png';
import organizedCloset from '../assets/photos/before-after/closet-after.jpg';
import carpetImg from '../assets/photos/carpet-clean-room.jpg';
import seniorImg from '../assets/photos/senior-home-support.png';

const services = [
  {
    id: 'deep-cleaning',
    name: 'Deep Cleaning',
    detail: 'A top-to-bottom reset for homes that need more than a surface clean.',
    img: deepImg,
    alt: 'Spotless home kitchen after a deep clean',
    items: [
      'Kitchens: inside oven, cabinet fronts, sinks, and appliances',
      'Bathrooms: tile, grout, glass, toilets, and fixtures',
      'Baseboards, window sills, blinds, and light fixtures',
      'Floors vacuumed and mopped, edges and corners included',
    ],
  },
  {
    id: 'recurring-cleaning',
    name: 'Weekly, Biweekly & Monthly Cleaning',
    detail: 'The same dedicated crew on your schedule, so your home stays pristine.',
    img: recurringImg,
    alt: 'Clean, bright home bathroom',
    items: [
      'Weekly, biweekly, or monthly service',
      'Dusting, vacuuming, mopping, and trash removal',
      'Kitchens, bathrooms, bedrooms, and living areas',
      'Consistent crew assignment so the same team knows your home',
    ],
  },
  {
    id: 'move-in-move-out',
    name: 'Move-In / Move-Out Cleaning',
    detail: 'Leave it spotless or start fresh in a home that is truly move-in ready.',
    img: moveImg,
    alt: 'Empty, freshly cleaned living room',
    items: [
      'Inside and outside of cabinets, drawers, and closets',
      'Inside oven, refrigerator, and microwave',
      'Bathrooms fully sanitized, floors vacuumed and mopped',
      'Inspection-ready checklist for landlords and buyers',
    ],
  },
  {
    id: 'pre-listing',
    name: 'Pre-Listing Cleaning',
    detail: 'Show-ready cleans that help your home photograph, show, and sell at its best.',
    img: listingImg,
    alt: 'Bright, showing-ready living room',
    items: [
      'Full interior deep clean before photos and showings',
      'Windows, mirrors, and glass streak-free',
      'Fresh, neutral scent with no lingering odors',
      'Touch-up cleans before open houses',
    ],
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Residential Cleaning',
    provider: { '@type': 'HomeAndConstructionBusiness', name: 'Blueprint Clean Co.' },
    areaServed: site.serviceCounties.map((c) => `${c} County, TN`),
    description:
      'Residential cleaning in Middle Tennessee: deep cleaning, weekly, biweekly and monthly cleaning, move-in/move-out and pre-listing cleaning, home organization, carpet and upholstery cleaning, and senior cleaning services.',
  },
];
---
<Layout
  title="Residential Cleaning in Middle Tennessee | Blueprint Clean Co."
  description="Residential cleaning for Middle Tennessee homeowners: deep cleaning, weekly, biweekly and monthly service, move-in/move-out, pre-listing, home organization, carpet and upholstery, and senior cleaning services."
  schema={schema}
>
  <PageHero
    eyebrow="For Homeowners"
    title="Residential Cleaning"
    subtitle="A cleaner, calmer home with a team you can trust. Deep cleans, regular service, organization, and more, tailored to your family and your schedule."
    image={heroImg}
  >
    <div class="btn-row" style="margin-top:24px;">
      <a href={site.quoteHref} class="btn btn-solid">Get a Free Quote</a>
      <a href={site.phoneHref} class="btn btn-ghost-light">Call Now</a>
      <a href={site.smsHref} class="btn btn-ghost-light">Text Us</a>
    </div>
  </PageHero>
  <Marquee items={trustTicker} />

  <section id="services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Cleaning for Your Home</p>
        <h2>Choose what your home <span class="accent">needs most</span></h2>
        <p class="lede">One-time or ongoing, we will build a plan around your home and your routine.</p>
      </div>
      <div class="grid grid-2 res-grid">
        {services.map((s) => (
          <div class="card res-card" id={s.id}>
            <div class="res-card__photo">
              <Image src={s.img} alt={s.alt} width={720} height={420} class="graded-img" />
            </div>
            <div class="res-card__body">
              <h3>{s.name}</h3>
              <p>{s.detail}</p>
              <ul class="check-list">
                {s.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
      <div style="margin-top:36px;">
        <a href="/gallery/#residential" class="btn">See Residential Before &amp; Afters</a>
      </div>
    </div>
  </section>

  <section id="organization" class="section-alt">
    <div class="container">
      <div class="feature-row">
        <div>
          <p class="eyebrow">Home Organization</p>
          <h2>A home that is <span class="accent">clean and organized</span></h2>
          <p class="lede">
            A deep clean is even better when everything has a place. We sort, label, and set up simple systems for
            closets, pantries, and storage areas so the order lasts long after we leave.
          </p>
          <ul class="check-list">
            <li>Closets, pantries, and storage areas</li>
            <li>Labeled bins and clear, simple systems</li>
            <li>Decluttering and sorting by category</li>
          </ul>
          <div class="btn-row" style="margin-top:28px;">
            <a href={site.quoteHref} class="btn btn-solid">Ask About Organization</a>
          </div>
        </div>
        <div class="feature-row__media">
          <Image src={organizedCloset} alt="Freshly organized closet with labeled bins" width={900} height={650} class="graded-img" />
        </div>
      </div>
    </div>
  </section>

  <section id="carpet-upholstery">
    <div class="container">
      <div class="feature-row feature-row--flip">
        <div class="feature-row__media">
          <Image src={carpetImg} alt="Freshly cleaned carpet in a bright room" width={900} height={650} class="graded-img" />
        </div>
        <div>
          <p class="eyebrow">Carpet &amp; Upholstery Cleaning</p>
          <h2>Fresh floors and <span class="accent">refreshed furniture</span></h2>
          <p class="lede">
            Carpets and upholstered furniture hold on to everyday wear. We bring them back to life so your home looks
            and feels fresher.
          </p>
          <ul class="check-list">
            <li>Carpet cleaning for living areas, bedrooms, and stairs</li>
            <li>Upholstery cleaning for sofas, chairs, and cushions</li>
            <li>Attention to high-traffic areas and visible spots</li>
            <li>A great add-on to a deep clean, move-in, or pre-listing service</li>
          </ul>
          <div class="btn-row" style="margin-top:28px;">
            <a href={site.quoteHref} class="btn btn-solid">Request Carpet &amp; Upholstery Cleaning</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="senior-cleaning" class="section-alt">
    <div class="container">
      <div class="feature-row">
        <div>
          <p class="eyebrow">Senior Cleaning Services</p>
          <h2>Care you can <span class="accent">trust</span></h2>
          <p class="lede">
            Designed to help older adults enjoy a clean, safe, dependable, and comfortable home, supporting
            independence and quality of life.
          </p>
          <ul class="check-list">
            <li>Light housekeeping and laundry</li>
            <li>Dusting, vacuuming, sweeping, and mopping</li>
            <li>Bathroom and kitchen refresh</li>
            <li>Grocery shopping</li>
            <li>Window and door security check</li>
            <li>Home wellness check and reporting to family</li>
          </ul>
          <div class="btn-row" style="margin-top:28px;">
            <a href={site.quoteHref} class="btn btn-solid">Ask About Senior Services</a>
          </div>
        </div>
        <div class="feature-row__media">
          <Image src={seniorImg} alt="Smiling senior woman in a bright, comfortable home" width={900} height={650} class="graded-img" />
        </div>
      </div>
    </div>
  </section>

  <section id="reviews">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Reviews</p>
        <h2>Loved by <span class="accent">local homeowners</span></h2>
      </div>
      <TestimonialCarousel />
    </div>
  </section>

  <ClosingCTA heading="Ready for a spotless home?" body="Tell us about your home and we will put together a plan, one-time or recurring." />
</Layout>

<style>
  .res-grid {
    gap: 28px;
  }

  .res-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .res-card__photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .res-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .res-card__body {
    padding: 28px 30px 32px;
  }

  .res-card__body > p {
    color: var(--text-dim);
  }

  .feature-row--flip .feature-row__media {
    order: -1;
  }

  @media (max-width: 800px) {
    .feature-row--flip .feature-row__media {
      order: 0;
    }
  }
</style>
