---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Marquee from '../components/Marquee.astro';
import { site, trustTicker } from '../lib/site';
import heroImg from '../assets/photos/gallery-bathroom-vanity.jpeg';

const phases = [
  {
    phase: 'Phase 01',
    title: 'Initial Construction Cleanup',
    detail:
      'Removal of construction debris, stickers, tags, protective film, and heavy dust from every surface, cabinet interior, window track, and vent. We clear the site so trades and inspectors can move through safely.',
  },
  {
    phase: 'Phase 02',
    title: 'Rough & Progress Cleaning',
    detail:
      'Ongoing cleaning as trades finish: wiping down surfaces, spot-cleaning marks left from trim, flooring, and fixture installs, and clearing any dust stirred up along the way.',
  },
  {
    phase: 'Phase 03',
    title: 'Final Detail & Turnover Cleaning',
    detail:
      'The deep, top-to-bottom clean, cabinets inside and out, all fixtures, baseboards, light fixtures, appliances, and floors, completed right before your final walkthrough or closing so the property is spotless for buyers, owners, or tenants.',
  },
];

const faqs = [
  {
    q: 'When should I schedule each phase?',
    a: 'Phase 01 typically happens once major trades finish and drywall/paint are done. Phase 02 follows as trim, flooring, and fixture installs wrap up. Phase 03 is scheduled right before your walkthrough or closing date.',
  },
  {
    q: 'Do you work with builders on multiple properties at once?',
    a: 'Yes, we regularly coordinate with home builders and contractors managing several new builds at a time, and can work around your production schedule.',
  },
  {
    q: 'What is included in Phase 01, Initial Construction Cleanup?',
    a: 'Debris removal, dusting of all surfaces, removal of protective stickers and window film, initial vacuum/sweep of floors, and clearing construction dust from cabinets, vents, and light fixtures.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Post-Construction Cleaning',
    provider: { '@type': 'HomeAndConstructionBusiness', name: 'Blueprint Clean Co.' },
    areaServed: 'Nashville, TN',
    description:
      'Post-construction cleaning for general contractors, builders, developers, and property managers in three phases: initial construction cleanup, rough and progress cleaning, and final detail and turnover cleaning.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout
  title="Post-Construction Cleaning Nashville | 3-Phase New Build Cleaning"
  description="Professional post-construction cleaning for general contractors, builders, developers, and property managers in Middle Tennessee: initial construction cleanup, rough and progress cleaning, and final detail and turnover cleaning."
  schema={schema}
>
  <PageHero
    eyebrow="For Builders, General Contractors & Construction Companies"
    title="Post-Construction 3-Phase Cleaning"
    subtitle="A structured, three-phase process that takes every new build from job site to move-in ready, on your schedule."
    image={heroImg}
    blueprint
    sheetLabel="Sheet P-01 / 3-Phase Cleaning Plan"
  >
    <div class="btn-row" style="margin-top:24px;">
      <a href={site.quoteHref} class="btn btn-solid">Get a Free Quote</a>
      <a href={site.phoneHref} class="btn btn-ghost-light">Call Now</a>
      <a href={site.smsHref} class="btn btn-ghost-light">Text Us</a>
    </div>
  </PageHero>
  <Marquee items={trustTicker} />

  <section class="bp-sheet">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Professional Post-Construction Cleaning Services</p>
        <h2>Construction Site to <span class="accent">Move-In Ready</span></h2>
        <p class="lede">
          Blueprint Clean Co. provides detailed post-construction cleaning services for general contractors,
          builders, developers, and property managers.
        </p>
      </div>

      <div class="phase-list">
        {phases.map((p) => (
          <div class="phase-card">
            <span class="phase-card__tag">{p.phase}</span>
            <h3>{p.title}</h3>
            <p>{p.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="grid grid-2" style="align-items:center; gap:56px;">
        <div>
          <p class="eyebrow">Why Builders Choose Us</p>
          <h2>Built for <span class="accent">production schedules</span></h2>
          <ul class="standard-list">
            <li>Coordinated scheduling across multiple lots or units</li>
            <li>Crews trained specifically on post-construction debris and dust</li>
            <li>Detailed checklists so every trade's mess gets caught</li>
            <li>Flexible timing for Phase 3 right up to closing day</li>
            <li>Direct communication with your site superintendent</li>
          </ul>
          <a href={site.quoteHref} class="btn btn-solid" style="margin-top:16px;">Request a Quote</a>
        </div>
        <div class="card" style="padding:32px;">
          <h3>Also serving builders with:</h3>
          <ul class="standard-list">
            <li>Pre-listing prep for model homes &amp; spec sales</li>
            <li>Final clean and turnover for closing day</li>
            <li><a href="/commercial-cleaning/">Recurring maintenance</a> for sales offices</li>
            <li><a href="/gallery/#post-construction">See our post-construction work</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Post-Construction Cleaning Questions</h2>
      </div>
      <div style="max-width:760px; margin:0 auto;">
        <FAQAccordion items={faqs} />
      </div>
    </div>
  </section>

  <section style="background:var(--bg-raised); border-top:1px solid var(--border);">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Social Proof</p>
        <h2>Trusted for <span class="accent">show-ready results</span></h2>
      </div>
      <TestimonialCarousel />
    </div>
  </section>

  <ClosingCTA heading="Ready to schedule your new build?" body="Tell us your production timeline and we'll build a 3-phase plan around it." />
</Layout>

<style>
  .bp-sheet {
    background-color: #0a1a33;
    background-image:
      linear-gradient(rgba(126, 166, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(126, 166, 255, 0.12) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .bp-sheet h2,
  .bp-sheet h3 {
    color: #ffffff;
  }
  .bp-sheet .eyebrow {
    color: var(--accent-on-dark);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    letter-spacing: 0.18em;
  }
  .bp-sheet .accent {
    color: var(--accent-on-dark);
  }
  .bp-sheet .lede {
    color: rgba(219, 231, 255, 0.85);
  }
  .phase-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .phase-card {
    position: relative;
    padding: 32px 28px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(126, 166, 255, 0.4);
  }
  .phase-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 18px;
    height: 18px;
    border-top: 3px solid var(--accent-on-dark);
    border-left: 3px solid var(--accent-on-dark);
  }
  .phase-card__tag {
    display: inline-block;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-on-dark);
    margin-bottom: 10px;
  }
  .phase-card p {
    color: rgba(219, 231, 255, 0.85);
    font-size: 0.94rem;
    margin: 0;
  }
  .standard-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .standard-list li {
    padding-left: 26px;
    position: relative;
    color: var(--text-dim);
  }
  .standard-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--accent-bright);
    font-weight: 700;
  }
  .standard-list a { color: var(--text); font-weight: 600; }
  .standard-list a:hover { color: var(--accent-bright); }

  @media (max-width: 900px) {
    .phase-list { grid-template-columns: 1fr; }
  }

</style>
