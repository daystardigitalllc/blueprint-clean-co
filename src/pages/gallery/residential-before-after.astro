---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import Marquee from '../../components/Marquee.astro';
import { trustTicker } from '../../lib/site';
import heroImg from '../../assets/photos/lived-in-bathroom-clean.jpg';

import toiletBefore from '../../assets/photos/before-after/toilet-before.jpg';
import toiletAfter from '../../assets/photos/before-after/toilet-after.jpg';
import sinkBefore from '../../assets/photos/before-after/sink-before.jpg';
import sinkAfter from '../../assets/photos/before-after/sink-after.jpg';
import ovenBefore from '../../assets/photos/before-after/oven-before.jpg';
import ovenAfter from '../../assets/photos/before-after/oven-after.jpg';
---
<Layout
  title="Recurring Residential Cleaning, Before & After | Blueprint Clean Co."
  description="Real before-and-after results from Blueprint Clean Co.'s recurring residential cleaning teams in Nashville and Middle Tennessee."
>
  <PageHero
    eyebrow="Recurring Residential"
    title="Before & After: Recurring Residential Cleaning"
    subtitle="Recurring residential is a core part of what we do, separate from our project-based turnover, post-construction, and pre-listing work. Here's the difference our teams make, visit after visit."
    image={heroImg}
  />
  <Marquee items={trustTicker} />

  <section>
    <div class="container">
      <div class="grid grid-3">
        <BeforeAfterSlider id="res-toilet" before={toiletBefore} after={toiletAfter} label="Toilet, Deep Clean" />
        <BeforeAfterSlider id="res-sink" before={sinkBefore} after={sinkAfter} label="Bathroom Sink, Deep Clean" />
        <BeforeAfterSlider id="res-oven" before={ovenBefore} after={ovenAfter} label="Oven, Deep Clean" />
      </div>
    </div>
  </section>

  <ClosingCTA heading="Want a consistent, spotless home?" body="Ask about setting up recurring residential service." />
</Layout>
