---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Marquee from '../../components/Marquee.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import GalleryComingSoon from '../../components/GalleryComingSoon.astro';
import { Image } from 'astro:assets';
import { trustTicker } from '../../lib/site';

import toiletBefore from '../../assets/photos/before-after/toilet-before.jpg';
import toiletAfter from '../../assets/photos/before-after/toilet-after.jpg';
import sinkBefore from '../../assets/photos/before-after/sink-before.jpg';
import sinkAfter from '../../assets/photos/before-after/sink-after.jpg';
import ovenBefore from '../../assets/photos/before-after/oven-before.jpg';
import ovenAfter from '../../assets/photos/before-after/oven-after.jpg';
import closetBefore from '../../assets/photos/before-after/closet-before.jpg';
import closetAfter from '../../assets/photos/before-after/closet-after.jpg';
import pantryBefore from '../../assets/photos/before-after/pantry-before.jpg';
import pantryAfter from '../../assets/photos/before-after/pantry-after.jpg';

import livedInKitchen from '../../assets/photos/lived-in-kitchen-clean.jpg';
import residentialKitchen from '../../assets/photos/residential-kitchen-clean.jpg';
import livedInBathroom from '../../assets/photos/lived-in-bathroom-clean.jpg';
import shower from '../../assets/photos/gallery-shower-glass.jpg';
import emptyLiving from '../../assets/photos/empty-living-room-clean.jpg';
import livingRoom2 from '../../assets/photos/hero-living-room-2.png';
import showerStall from '../../assets/photos/shower-stall-clean.jpg';
import fridgeEmpty from '../../assets/photos/turnover-fridge-empty.jpg';
import stoveClean from '../../assets/photos/turnover-stove-clean.jpg';
import kitchenAngle1 from '../../assets/photos/turnover-kitchen-angle1.jpg';
import kitchenAngle2 from '../../assets/photos/turnover-kitchen-angle2.jpg';
import livingRoomShelf from '../../assets/photos/turnover-living-room-shelf.jpg';
import livingRoomAccentWall from '../../assets/photos/turnover-living-room-accent-wall.jpg';
import living1 from '../../assets/photos/hero-living-room-1.png';
import vanity from '../../assets/photos/gallery-bathroom-vanity.jpeg';
import stagedBath from '../../assets/photos/staged-bathroom-vessel-sink.jpg';
import hallway from '../../assets/photos/hallway-clean.jpg';

import marbleKitchen from '../../assets/photos/hero-kitchen-marble.png';
import kitchenSink from '../../assets/photos/gallery-kitchen-sink.jpg';
import bathroomFaucet from '../../assets/photos/gallery-bathroom-faucet.jpg';

const homePhotos = [
  { img: livedInKitchen, alt: 'Freshly cleaned home kitchen' },
  { img: residentialKitchen, alt: 'Spotless residential kitchen after a deep clean' },
  { img: livedInBathroom, alt: 'Clean, bright home bathroom' },
  { img: shower, alt: 'Spotless glass shower enclosure' },
  { img: showerStall, alt: 'Spotless tub and shower stall' },
  { img: stoveClean, alt: 'Detail-cleaned glass-top stove and range, no cooking residue' },
  { img: marbleKitchen, alt: 'Spotless kitchen with marble counters after a deep clean' },
  { img: kitchenSink, alt: 'Detail-cleaned kitchen sink' },
  { img: bathroomFaucet, alt: 'Polished bathroom faucet and countertop' },
];

const moveOutPhotos = [
  { img: emptyLiving, alt: 'Empty, freshly cleaned living room ready for the next move-in' },
  { img: livingRoom2, alt: 'Move-in ready living room, fully cleaned' },
  { img: fridgeEmpty, alt: 'Empty, spotless refrigerator after a move-out clean' },
  { img: kitchenAngle1, alt: 'Move-out ready kitchen with spotless counters and appliances' },
  { img: kitchenAngle2, alt: 'Freshly cleaned kitchen, cabinets and floors ready for move-in' },
  { img: livingRoomShelf, alt: 'Empty living room with built-in shelving, move-out ready' },
  { img: livingRoomAccentWall, alt: 'Empty living room with accent wall, spotless floors' },
];

const listingPhotos = [
  { img: living1, alt: 'Bright, showing-ready living room' },
  { img: vanity, alt: 'Tidy, staged bathroom vanity ready for showings' },
  { img: stagedBath, alt: 'Bright, staged bathroom with vessel sink ready for showings' },
  { img: hallway, alt: 'Freshly cleaned hallway and entry, showing-ready' },
];

const sections = [
  { id: 'residential', label: 'Residential' },
  { id: 'commercial', label: 'Commercial' },
  { id: 'post-construction', label: 'Post-Construction' },
];
---
<Layout
  title="Our Work | Before & After Gallery | Blueprint Clean Co."
  description="See Blueprint Clean Co.'s work organized by residential, commercial, and post-construction cleaning, with interactive before and after sliders."
>
  <PageHero eyebrow="Our Work" title="Precision you can see." subtitle="Drag the sliders to compare before and after, or browse our work by cleaning type." />
  <Marquee items={trustTicker} />

  <div class="gallery-blue">
    <section class="jump">
      <div class="container">
        <nav class="jump__list" aria-label="Gallery sections">
          {sections.map((s) => <a href={`#${s.id}`} class="jump__chip">{s.label}</a>)}
        </nav>
      </div>
    </section>

    <section id="residential">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Residential</p>
          <h2>Home cleaning <span class="accent">before &amp; after</span></h2>
          <p class="lede">Real jobs from our residential crews. Drag the handle to compare.</p>
        </div>
        <div class="grid grid-3">
          <BeforeAfterSlider id="g-toilet" before={toiletBefore} after={toiletAfter} label="Toilet, Deep Clean" />
          <BeforeAfterSlider id="g-sink" before={sinkBefore} after={sinkAfter} label="Bathroom Sink, Deep Clean" />
          <BeforeAfterSlider id="g-oven" before={ovenBefore} after={ovenAfter} label="Oven, Deep Clean" />
        </div>

        <h3 class="sub-head">Home organization</h3>
        <div class="grid grid-2">
          <BeforeAfterSlider id="g-closet" before={closetBefore} after={closetAfter} label="Closet Organization" landscape />
          <BeforeAfterSlider id="g-pantry" before={pantryBefore} after={pantryAfter} label="Pantry Organization" landscape />
        </div>

        <h3 class="sub-head">Finished homes</h3>
        <div class="grid grid-3 gallery-grid">
          {homePhotos.map((p) => (
            <figure class="gallery-item">
              <Image src={p.img} alt={p.alt} width={500} height={620} class="graded-img" />
            </figure>
          ))}
        </div>

        <h3 class="sub-head">Move-in &amp; move-out cleaning</h3>
        <div class="grid grid-4 gallery-grid">
          {moveOutPhotos.map((p) => (
            <figure class="gallery-item">
              <Image src={p.img} alt={p.alt} width={500} height={620} class="graded-img" />
            </figure>
          ))}
        </div>

        <h3 class="sub-head">Pre-listing cleaning</h3>
        <div class="grid grid-4 gallery-grid">
          {listingPhotos.map((p) => (
            <figure class="gallery-item">
              <Image src={p.img} alt={p.alt} width={500} height={620} class="graded-img" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="commercial" class="band">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Commercial</p>
          <h2>Offices, retail &amp; <span class="accent">commercial spaces</span></h2>
        </div>
        <GalleryComingSoon message="Commercial project photos are on the way, check back soon, or ask us for examples directly." />
      </div>
    </section>

    <section id="post-construction">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Post-Construction</p>
          <h2>New Build, <span class="accent">Final Clean</span></h2>
          <p class="lede">Our 3-phase cleaning takes new construction from job site to final walkthrough.</p>
        </div>
        <GalleryComingSoon message="New build photos are on the way, check back soon, or ask us for examples directly." />
      </div>
    </section>
  </div>

  <ClosingCTA tone="navy" heading="Want results like these?" body="Tell us about your space and we will put together a plan." />
</Layout>

<style>
  .gallery-blue {
    background: var(--accent);
    color: #ffffff;
  }

  .gallery-blue :global(h2),
  .gallery-blue :global(h3) {
    color: #ffffff;
  }

  .gallery-blue :global(.eyebrow),
  .gallery-blue :global(.accent) {
    color: #bcd2ff;
  }

  .gallery-blue :global(.lede) {
    color: rgba(255, 255, 255, 0.88);
  }

  .band {
    background: #1a43c4;
  }

  .gallery-blue :global(.gallery-item) {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .gallery-blue :global(.ba-slider__tag--after) {
    background: #ffffff;
    color: var(--accent-bright);
    border-color: #ffffff;
  }

  .gallery-blue :global(.ba-slider__frame) {
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: 0 10px 28px rgba(5, 15, 50, 0.3);
  }

  .jump {
    padding: 28px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }

  .jump__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .jump__chip {
    padding: 9px 18px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9rem;
    color: #ffffff;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .jump__chip:hover,
  .jump__chip:focus-visible {
    background: #ffffff;
    color: var(--accent-bright);
  }

  .sub-head {
    margin: 56px 0 20px;
  }
</style>
