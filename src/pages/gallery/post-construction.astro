---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import GalleryComingSoon from '../../components/GalleryComingSoon.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import Marquee from '../../components/Marquee.astro';
import { trustTicker } from '../../lib/site';
import { Image } from 'astro:assets';

import kitchen from '../../assets/photos/hero-kitchen-marble.png';
import sink from '../../assets/photos/gallery-kitchen-sink.jpg';
import faucet from '../../assets/photos/gallery-bathroom-faucet.jpg';

const items = [
  { img: kitchen, alt: 'Spotless new-build kitchen after final detail clean' },
  { img: sink, alt: 'Detail-cleaned kitchen sink, no construction dust' },
  { img: faucet, alt: 'Polished bathroom faucet, post-construction detail' },
];
---
<Layout
  title="Post-Construction Cleaning Gallery | Blueprint Clean Co."
  description="See Blueprint Clean Co.'s 3-phase post-construction cleaning work for Nashville home builders and contractors."
>
  <PageHero
    eyebrow="Post-Construction"
    title="Post-Construction 3-Phase Cleaning Gallery"
    subtitle="New builds, taken from rough clean to move-in ready, kept separate here from our residential and turnover work."
  />
  <Marquee items={trustTicker} />

  <section>
    <div class="container">
      <div class="grid grid-3 gallery-grid">
        {items.map((item) => (
          <figure class="gallery-item">
            <Image src={item.img} alt={item.alt} width={500} height={620} class="graded-img" />
          </figure>
        ))}
      </div>
      <div style="margin-top:32px;">
        <GalleryComingSoon message="More new-build project photos are on the way as builders share job completions with us." />
      </div>
      <div style="text-align:center; margin-top:24px;">
        <a href="/post-construction-cleaning/" class="btn btn-sm">See Post-Construction Service Details</a>
      </div>
    </div>
  </section>

  <ClosingCTA heading="Have a new build coming up?" body="Tell us your production timeline and we'll build a 3-phase plan around it." />
</Layout>

<style>
  .gallery-grid { gap: 20px; }
  .gallery-item {
    margin: 0;
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4/5;
  }
</style>
