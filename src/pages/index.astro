---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site, trustTicker } from '../lib/site';
import { Image } from 'astro:assets';
import residentialPhoto from '../assets/photos/residential-kitchen-clean.jpg';
import commercialPhoto from '../assets/photos/hero-vacuum-living-room.jpg';
import whyPhoto from '../assets/photos/hero-living-room-1.png';

const residential = [
  'Deep cleaning',
  'Recurring weekly, bi-weekly & monthly service',
  'Move-in / move-out cleaning',
  'Home organization',
  'Holiday, getaway & senior home support',
];

const commercial = [
  'Offices & professional spaces',
  'Retail spaces & storefronts',
  'Janitorial services',
  'Property management turnovers',
  'Commercial cleaning contracts',
];
---
<Layout
  title="Blueprint Clean Co. | Residential & Commercial Cleaning in Middle Tennessee"
  description="Blueprint Clean Co. delivers precision cleaning and professional results for homes and businesses across 11 Middle Tennessee counties: residential, commercial, and post-construction cleaning."
>
  <Hero />
  <Marquee items={trustTicker} />

  <section id="what-we-do">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">What We Do</p>
        <h2>Cleaning for <span class="accent">homes and businesses</span></h2>
        <p class="lede">
          Whether it's your home or your business, our crews deliver the same precision, the same checklists,
          and the same professional results.
        </p>
      </div>

      <div class="grid grid-2 split">
        <article class="split-card card">
          <div class="split-card__photo">
            <Image src={residentialPhoto} alt="Freshly cleaned home kitchen" width={720} height={480} class="graded-img" />
          </div>
          <div class="split-card__body">
            <p class="eyebrow">Residential</p>
            <h3>Residential Cleaning</h3>
            <p>Spotless homes, whether it's a one-time reset or a recurring routine you can count on.</p>
            <ul class="check-list">
              {residential.map((item) => <li>{item}</li>)}
            </ul>
            <div class="btn-row split-card__cta">
              <a href="/residential-cleaning/" class="btn btn-solid">Explore Residential</a>
              <a href={site.quoteHref} class="btn">Get a Quote</a>
            </div>
          </div>
        </article>

        <article class="split-card card">
          <div class="split-card__photo">
            <Image src={commercialPhoto} alt="Professional cleaner vacuuming a bright, modern space" width={720} height={480} class="graded-img" />
          </div>
          <div class="split-card__body">
            <p class="eyebrow">Commercial</p>
            <h3>Commercial Cleaning</h3>
            <p>Clean, welcoming workplaces that make the right impression on your team and your customers.</p>
            <ul class="check-list">
              {commercial.map((item) => <li>{item}</li>)}
            </ul>
            <div class="btn-row split-card__cta">
              <a href="/commercial-cleaning/" class="btn btn-solid">Explore Commercial</a>
              <a href={site.quoteHref} class="btn">Get a Quote</a>
            </div>
          </div>
        </article>
      </div>

      <div class="postcon card">
        <div>
          <p class="eyebrow">New Builds</p>
          <h3>Post-Construction 3-Phase Cleaning</h3>
          <p>Rough clean, touch-up, and final detail clean that takes a new build from job site to move-in ready.</p>
        </div>
        <a href="/post-construction-cleaning/" class="btn btn-solid">See the 3-Phase Process</a>
      </div>
    </div>
  </section>

  <section id="why-us" class="section-alt">
    <div class="container">
      <div class="grid grid-2" style="align-items:center; gap:48px;">
        <div>
          <p class="eyebrow">Why Us</p>
          <h2>The <span class="accent">Blueprint Standard</span></h2>
          <p class="lede">
            Precision isn't just a promise, it's our standard. Every service follows proven quality control
            processes, detailed inspections, and meticulous attention to detail.
          </p>
          <ul class="check-list">
            <li>Locally owned &amp; operated in Middle Tennessee</li>
            <li>Right equipment &amp; eco-friendly, high-performance products</li>
            <li>Property protection on every job, every time</li>
            <li>Transparent pricing, no surprise fees</li>
            <li>Fast, responsive communication from quote to walkthrough</li>
          </ul>
        </div>
        <div class="why-photo">
          <Image src={whyPhoto} alt="Real Blueprint Clean Co. client kitchen, freshly cleaned" width={640} height={760} class="graded-img" />
        </div>
      </div>
    </div>
  </section>

  <section id="service-area">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Service Area</p>
        <h2>Proudly serving <span class="accent">11 Middle Tennessee counties</span></h2>
        <p class="lede">Based in Nashville and serving homes and businesses across the region.</p>
      </div>
      <ServiceAreaMap />
    </div>
  </section>

  <section id="reviews" class="section-alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Reviews</p>
        <h2>Rated 5.0 by local <span class="accent">homeowners &amp; partners</span></h2>
        <div class="stars" style="display:block; font-size:1.2rem;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
      </div>
      <TestimonialCarousel />
    </div>
  </section>

  <section id="our-work">
    <div class="container work-cta">
      <p class="eyebrow">Our Work</p>
      <h2>See the difference <span class="accent">for yourself</span></h2>
      <p class="lede">Drag-to-compare before and after photos from real Blueprint Clean Co. jobs.</p>
      <a href="/gallery/" class="btn btn-solid">View Our Work</a>
    </div>
  </section>

  <ClosingCTA />
</Layout>

<style>
  .split {
    gap: 28px;
    align-items: stretch;
  }

  .split-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .split-card__photo {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .split-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split-card__body {
    padding: 30px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .split-card__body > p:not(.eyebrow) {
    color: var(--text-dim);
  }

  .split-card__cta {
    margin-top: auto;
    padding-top: 26px;
  }

  .postcon {
    margin-top: 28px;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--accent-soft);
    border-color: #c9d9ff;
  }

  .postcon h3 {
    margin-bottom: 4px;
  }

  .postcon p:not(.eyebrow) {
    margin: 0;
    color: var(--text-dim);
  }

  .why-photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .why-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .work-cta {
    text-align: center;
    max-width: 640px;
  }

  @media (max-width: 800px) {
    .postcon {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
