---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import Credentials from '../components/Credentials.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site, trustTicker } from '../lib/site';
import { Image } from 'astro:assets';
import residentialPhoto from '../assets/photos/residential-kitchen-clean.jpg';
import commercialPhoto from '../assets/photos/hero-vacuum-living-room.jpg';

const residential = [
  'Deep cleaning',
  'Weekly, biweekly & monthly cleaning',
  'Move-in / move-out & pre-listing cleaning',
  'Home organization',
  'Carpet, upholstery & senior cleaning services',
];

const commercial = [
  'Office cleaning',
  'Retail & commercial facility cleaning',
  'Recurring janitorial services',
  'Property management cleaning',
  'Custom contracts & government cleaning',
];
---
<Layout
  title="Blueprint Clean Co. | Residential & Commercial Cleaning in Middle Tennessee"
  description="Woman-owned Blueprint Clean Co. provides precision residential and commercial cleaning across 11 Middle Tennessee counties, plus post-construction cleaning for builders and contractors."
>
  <Hero />
  <Marquee items={trustTicker} />

  <section id="welcome">
    <div class="container welcome">
      <p class="eyebrow">Welcome</p>
      <h2>Residential and commercial cleaning, <span class="accent">done right</span></h2>
      <p class="lede">
        Blueprint Clean Co. is a woman-owned and operated cleaning company serving homeowners, businesses, and
        government facilities throughout Middle Tennessee. We bring the same precision, detailed checklists, and
        professional results to every space we clean, big or small.
      </p>
      <div class="btn-row welcome__cta">
        <a href={site.quoteHref} class="btn btn-solid">Request a Free Quote</a>
        <a href={site.phoneHref} class="btn">Call Now</a>
        <a href={site.smsHref} class="btn">Text Us</a>
      </div>
    </div>
  </section>

  <section id="what-we-do" class="section-alt">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">What We Do</p>
        <h2>Choose the cleaning that <span class="accent">fits your space</span></h2>
      </div>

      <div class="grid grid-2 split">
        <article class="split-card card">
          <div class="split-card__photo">
            <Image src={residentialPhoto} alt="Freshly cleaned home kitchen" width={720} height={480} class="graded-img" />
          </div>
          <div class="split-card__body">
            <p class="eyebrow">For Homeowners</p>
            <h3>Residential Cleaning</h3>
            <p>Spotless homes, whether it's a one-time reset or a routine you can count on.</p>
            <ul class="check-list">
              {residential.map((item) => <li>{item}</li>)}
            </ul>
            <div class="btn-row split-card__cta">
              <a href="/residential-cleaning/" class="btn btn-solid">Residential Cleaning</a>
            </div>
          </div>
        </article>

        <article class="split-card card">
          <div class="split-card__photo">
            <Image src={commercialPhoto} alt="Professional cleaner vacuuming a bright, modern space" width={720} height={480} class="graded-img" />
          </div>
          <div class="split-card__body">
            <p class="eyebrow">For Businesses</p>
            <h3>Commercial Cleaning</h3>
            <p>Clean, welcoming workplaces that make the right impression on your team and your customers.</p>
            <ul class="check-list">
              {commercial.map((item) => <li>{item}</li>)}
            </ul>
            <div class="btn-row split-card__cta">
              <a href="/commercial-cleaning/" class="btn btn-solid">Commercial Cleaning</a>
            </div>
          </div>
        </article>
      </div>

      <p class="builders">
        Building or renovating? <a href="/post-construction-cleaning/">See our post-construction cleaning for builders &amp; contractors &rarr;</a>
      </p>
    </div>
  </section>

  <section id="service-area">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Service Area</p>
        <h2>Proudly serving <span class="accent">11 Middle Tennessee counties</span></h2>
        <p class="lede">Based in Nashville and serving homes and businesses across the region.</p>
      </div>
      <ServiceAreaMap />
    </div>
  </section>

  <section id="credentials" class="section-blue creds">
    <div class="container creds__inner">
      <div>
        <p class="eyebrow">Credentials</p>
        <h2>Professional, accountable, <span class="accent">and proud of it</span></h2>
      </div>
      <Credentials tone="dark" />
    </div>
  </section>

  <section id="reviews">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Reviews</p>
        <h2>Rated 5.0 by local <span class="accent">homeowners &amp; partners</span></h2>
        <div class="stars" style="display:block; font-size:1.2rem;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
      </div>
      <TestimonialCarousel />
    </div>
  </section>

  <section id="our-work" class="section-alt">
    <div class="container work-cta">
      <p class="eyebrow">Our Work</p>
      <h2>See the difference <span class="accent">for yourself</span></h2>
      <p class="lede">Drag-to-compare before and after photos from real Blueprint Clean Co. jobs.</p>
      <a href="/gallery/" class="btn btn-solid">View Our Work</a>
    </div>
  </section>

  <ClosingCTA />
</Layout>

<style>
  .welcome {
    max-width: 780px;
    text-align: center;
  }

  .welcome__cta {
    justify-content: center;
    margin-top: 28px;
  }

  .split {
    gap: 28px;
    align-items: stretch;
  }

  .split-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .split-card__photo {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .split-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .split-card__body {
    padding: 30px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .split-card__body > p:not(.eyebrow) {
    color: var(--text-dim);
  }

  .split-card__cta {
    margin-top: auto;
    padding-top: 26px;
  }

  .builders {
    margin: 32px 0 0;
    text-align: center;
    color: var(--text-dim);
  }

  .builders a {
    color: var(--accent-bright);
    font-weight: 700;
  }

  .creds {
    padding: 56px 0;
  }

  .creds__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .creds h2 {
    margin: 0;
    max-width: 420px;
  }

  .work-cta {
    text-align: center;
    max-width: 640px;
  }
</style>
