---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { blueprintStandard } from '../lib/site';
import heroImg from '../assets/photos/lived-in-kitchen-clean.jpg';
---
<Layout
  title="About Us | Blueprint Clean Co."
  description="Blueprint Clean Co. delivers precision cleaning and professional results for realtors, property managers, home builders, and Airbnb hosts across Nashville and Middle Tennessee."
>
  <PageHero eyebrow="Our Story" title="Precision cleaning, professional results" image={heroImg} />

  <section>
    <div class="container" style="max-width:820px;">
      <p class="lede">
        At Blueprint Clean Co., we believe a clean space is more than just appearance, it's the final touch
        that brings a property to life. What started as a vision for dependable, detail-focused cleaning has
        grown into a company built on professionalism, precision, and pride in every project.
      </p>
      <p class="lede">
        We specialize in move-in and move-out cleanings, pre-listing preparation, 3-phase post-construction
        cleanup, Airbnb turnovers, and recurring residential and commercial cleaning throughout Nashville and
        Middle Tennessee.
      </p>
      <p class="lede">
        Our mission is simple: deliver spotless results with reliable service that property managers,
        contractors, realtors, and business owners can truly depend on. We don't just clean spaces. We help
        create fresh starts, polished presentations, and stress-free transitions through precision cleaning
        and professional results.
      </p>
    </div>
  </section>

  <section style="background:var(--bg-raised); border-top:1px solid var(--border); border-bottom:1px solid var(--border);">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The Blueprint Standard</p>
        <h2>Precision isn't a promise, <span class="accent">it's our standard</span></h2>
      </div>
      <div class="standard-list">
        {blueprintStandard.map((item, i) => (
          <div class="standard-row">
            <span class="standard-row__num">0{i + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Who We Serve</p>
        <h2>Built on <span class="accent">trust</span></h2>
      </div>
      <TrustBadges />
    </div>
  </section>

  <ClosingCTA />
</Layout>

<style>
  .standard-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .standard-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .standard-row__num {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--accent);
    font-size: 1.3rem;
  }
  .standard-row h3 {
    margin-bottom: 6px;
  }
  .standard-row p {
    color: var(--text-dim);
    font-size: 0.94rem;
    margin: 0;
  }
  @media (max-width: 560px) {
    .standard-row { grid-template-columns: 40px 1fr; }
  }
</style>
