---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';

const qualifications = [
  {
    title: 'Insured Business',
    detail: 'Coverage documentation available upon request',
    icon: 'M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5l8-3Zm-1.2 13.6l6-6-1.4-1.4-4.6 4.6-2-2-1.4 1.4 3.4 3.4Z',
  },
  {
    title: 'Registered LLC',
    detail: site.legalName,
    icon: 'M4 21V8l8-5 8 5v13h-6v-6h-4v6H4Zm4-9h2v-2H8v2Zm6 0h2v-2h-2v2Z',
  },
  {
    title: 'Federal Registration',
    detail: 'SAM.gov registration and CAGE Code',
    icon: 'M12 2L2 7v2h20V7L12 2ZM4 11v8H2v2h20v-2h-2v-8h-2v8h-3v-8h-2v8h-2v-8H9v8H6v-8H4Z',
  },
  {
    title: 'Professional Standards',
    detail: 'Documented cleaning procedures',
    icon: 'M9 2h6l1 2h3a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3l1-2Zm-1.7 12.3l1.4 1.4 2.3-2.3 4.6-4.6-1.4-1.4-4.6 4.6-.9-.9Z',
  },
];

const company = [
  { label: 'Legal Business Name', value: site.legalName },
  { label: 'Operating Name', value: site.name },
  { label: 'Ownership', value: 'Woman-Owned Business' },
  { label: 'Headquarters', value: 'Tennessee' },
  { label: 'Federal Contracting', value: 'CAGE Code Issued' },
];

const commitments = [
  {
    title: 'Quality-Control Procedures',
    detail: 'Structured checklists, team oversight, and photographic documentation for applicable projects.',
  },
  {
    title: 'Commercial & Construction Capabilities',
    detail: 'Cleaning solutions for residential properties, commercial facilities, and construction projects.',
  },
  {
    title: 'Professional Accountability',
    detail: 'Defined service scopes, documented expectations, and clear client communication.',
  },
];

const qualificationsHref = `mailto:${site.email}?subject=${encodeURIComponent('Request for Company Qualifications')}`;
---
<Layout
  title="Professional Credentials | Blueprint Clean Co."
  description="Blueprint Clean Co. is a woman-owned business operated by Sidonio Enterprises LLC, with SAM.gov registration, an assigned CAGE code, documented cleaning procedures, and insurance documentation available upon request."
>
  <section class="cred-hero section-navy">
    <div class="container cred-hero__inner">
      <div class="cred-hero__bar">
        <span>Blueprint Clean Co.</span>
        <span class="cred-hero__bar-right">Professional Credentials</span>
      </div>
      <p class="eyebrow">Our Qualifications</p>
      <h1>Built on Professionalism. Backed by Credentials.</h1>
      <p class="lede">
        Discover the business qualifications, insurance coverage, and professional standards behind Blueprint Clean Co.
      </p>
    </div>
  </section>

  <section class="cred-body">
    <div class="container cred-wrap">
      <div class="grid grid-4 qual-grid">
        {qualifications.map((q) => (
          <div class="qual">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d={q.icon} /></svg>
            <h3>{q.title}</h3>
            <p>{q.detail}</p>
          </div>
        ))}
      </div>

      <h2 class="cred-h2">Business &amp; Company Information</h2>
      <dl class="info">
        {company.map((row) => (
          <div class="info__row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>

      <h2 class="cred-h2">Our Professional Commitments</h2>
      <ul class="commit">
        {commitments.map((c) => (
          <li>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.5 12.5l3 3 6-6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <div>
              <h3>{c.title}</h3>
              <p>{c.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cred-cta section-navy">
    <div class="container cred-cta__inner">
      <h2>Partner With Blueprint Clean Co.</h2>
      <p class="lede">Request our qualifications, insurance documentation, or a customized service proposal.</p>
      <a href={qualificationsHref} class="btn btn-solid">Request Company Qualifications</a>
      <p class="cred-cta__contact">
        <a href={site.phoneHref}>{site.phone}</a> | blueprintclean.com
      </p>
    </div>
  </section>
</Layout>

<style>
  .cred-hero {
    padding: 190px 0 64px;
  }

  .cred-hero__inner {
    max-width: 920px;
  }

  .cred-hero__bar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 18px;
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cred-hero__bar-right {
    color: #9fbcff;
    font-weight: 700;
  }

  .cred-hero h1 {
    color: #ffffff;
    max-width: 760px;
  }

  .cred-hero .lede {
    max-width: 640px;
  }

  .cred-body {
    padding: 56px 0 72px;
  }

  .cred-wrap {
    max-width: 920px;
  }

  .qual-grid {
    gap: 16px;
  }

  .qual {
    padding: 24px 22px;
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    color: var(--accent);
  }

  .qual h3 {
    margin: 14px 0 6px;
    font-size: 1.1rem;
    color: var(--text);
  }

  .qual p {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .cred-h2 {
    margin: 64px 0 20px;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }

  .info {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .info__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .info dt {
    color: var(--text-dim);
  }

  .info dd {
    margin: 0;
    font-weight: 700;
    color: var(--text);
  }

  .commit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .commit li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    color: var(--accent);
  }

  .commit h3 {
    margin: 0 0 4px;
    font-size: 1.1rem;
    color: var(--text);
  }

  .commit p {
    margin: 0;
    color: var(--text-dim);
  }

  .cred-cta {
    padding: 64px 0;
  }

  .cred-cta__inner {
    text-align: center;
    max-width: 720px;
  }

  .cred-cta h2 {
    margin-bottom: 10px;
  }

  .cred-cta .btn {
    margin: 8px 0 20px;
  }

  .cred-cta__contact {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  .cred-cta__contact a {
    color: #ffffff;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .qual-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .cred-hero {
      padding: 130px 0 48px;
    }
  }
</style>
