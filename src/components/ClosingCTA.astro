---
import { site } from '../lib/site';
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Ready for spotless, stress-free results?',
  body = "Tell us about your space and timeline, we'll build a plan tailored to you.",
} = Astro.props;
---
<section class="closing-cta">
  <div class="container closing-cta__inner reveal">
    <h2>{heading}</h2>
    <p class="lede">{body}</p>
    <div class="btn-row" style="justify-content:center;">
      <a href={site.quoteHref} class="btn btn-invert">Request a Free Quote</a>
      <a href={site.phoneHref} class="btn btn-ghost-light">Call Now</a>
      <a href={site.smsHref} class="btn btn-ghost-light">Text Us</a>
    </div>
  </div>
</section>

<style>
  .closing-cta {
    background: var(--accent);
  }
  .closing-cta__inner {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }
  .closing-cta h2,
  .closing-cta .lede {
    color: #ffffff;
  }
  .closing-cta .lede {
    color: rgba(255,255,255,0.85);
  }
</style>
