---
import { trustAudiences } from '../lib/site';
---
<div class="trust-row">
  {trustAudiences.map((t) => (
    <div class="trust-row__item">
      <span class="trust-row__label">{t.label}</span>
      <span class="trust-row__detail">{t.detail}</span>
    </div>
  ))}
</div>

<style>
  .trust-row {
    display: flex;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .trust-row__item {
    flex: 1;
    padding: 24px 22px;
    border-left: 1px solid var(--border);
  }

  .trust-row__item:first-child {
    border-left: none;
  }

  .trust-row__label {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.02rem;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .trust-row__detail {
    display: block;
    color: var(--text-dim);
    font-size: 0.86rem;
  }

  @media (max-width: 900px) {
    .trust-row { flex-wrap: wrap; }
    .trust-row__item {
      flex: 1 1 50%;
      border-left: none;
      border-top: 1px solid var(--border);
    }
    .trust-row__item:nth-child(odd) {
      border-right: 1px solid var(--border);
    }
    .trust-row__item:nth-child(-n+2) {
      border-top: none;
    }
  }

  @media (max-width: 560px) {
    .trust-row__item {
      flex: 1 1 100%;
      border-right: none !important;
    }
    .trust-row__item:first-child {
      border-top: none;
    }
  }
</style>
