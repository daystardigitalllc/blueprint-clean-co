---
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
---
<ul class={`credentials credentials--${tone}`}>
  <li class="credentials__item">
    <span class="credentials__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 16.9 5.9 20.4l1.5-6.8L2.2 9l6.9-.7L12 2Z"/></svg>
    </span>
    <span class="credentials__text">Proudly Woman-Owned</span>
  </li>
  <li class="credentials__item">
    <span class="credentials__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5l8-3Zm-1.2 13.6l6-6-1.4-1.4-4.6 4.6-2-2-1.4 1.4 3.4 3.4Z"/></svg>
    </span>
    <span class="credentials__text">CAGE Code Assigned</span>
  </li>
</ul>

<style>
  .credentials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
  }

  .credentials__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 14px;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .credentials__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .credentials--light .credentials__item {
    background: var(--accent-soft);
    border: 1px solid #c9d9ff;
    color: var(--accent-bright);
  }

  .credentials--light .credentials__icon {
    background: var(--accent);
    color: #ffffff;
  }

  .credentials--dark .credentials__item {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }

  .credentials--dark .credentials__icon {
    background: #ffffff;
    color: var(--accent);
  }
</style>
