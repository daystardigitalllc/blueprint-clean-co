---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
}
const { eyebrow, title, subtitle, image } = Astro.props;
---
<section class={`page-hero ${image ? 'page-hero--photo' : ''}`}>
  {image && (
    <div class="page-hero__bg">
      <Image src={image} alt="" role="presentation" width={1920} height={900} loading="eager" fetchpriority="high" />
    </div>
  )}
  {image && <div class="page-hero__overlay"></div>}
  <div class="container page-hero__content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="lede">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 168px 0 72px;
    overflow: hidden;
    background: var(--bg);
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6,10,16,0.55) 0%, rgba(6,10,16,0.8) 75%, rgba(6,10,16,0.88) 100%);
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }

  .page-hero .lede {
    max-width: 600px;
  }

  .page-hero--photo h1,
  .page-hero--photo .lede {
    color: #ffffff;
  }

  .page-hero--photo .eyebrow {
    color: var(--accent-on-dark);
  }

  @media (max-width: 768px) {
    .page-hero { padding: 124px 0 52px; }
  }
</style>
