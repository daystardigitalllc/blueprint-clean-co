---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  blueprint?: boolean;
  sheetLabel?: string;
}
const { eyebrow, title, subtitle, image, blueprint = false, sheetLabel } = Astro.props;
---
<section class={`page-hero ${image ? 'page-hero--photo' : ''} ${blueprint ? 'page-hero--blueprint' : ''}`}>
  {image && (
    <div class="page-hero__bg">
      <Image src={image} alt="" role="presentation" width={1920} height={900} loading="eager" fetchpriority="high" />
    </div>
  )}
  {image && <div class="page-hero__overlay"></div>}
  {blueprint && <div class="page-hero__grid" aria-hidden="true"></div>}
  {blueprint && sheetLabel && <span class="page-hero__sheet" aria-hidden="true">{sheetLabel}</span>}
  <div class="container page-hero__content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="lede">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 168px 0 72px;
    overflow: hidden;
    background: var(--bg);
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(12,34,98,0.62) 0%, rgba(9,24,70,0.84) 75%, rgba(8,20,58,0.9) 100%);
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }

  .page-hero .lede {
    max-width: 600px;
  }

  .page-hero--photo h1,
  .page-hero--photo .lede {
    color: #ffffff;
  }

  .page-hero--photo .eyebrow {
    color: var(--accent-on-dark);
  }

  /* Blueprint variant: used only on the Post-Construction page */
  .page-hero--blueprint .page-hero__overlay {
    background: linear-gradient(180deg, rgba(10, 26, 51, 0.88) 0%, rgba(10, 26, 51, 0.94) 100%);
  }

  .page-hero__grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(126, 166, 255, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(126, 166, 255, 0.16) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .page-hero__sheet {
    position: absolute;
    right: 24px;
    bottom: 20px;
    z-index: 2;
    padding: 6px 10px;
    border: 1px solid rgba(126, 166, 255, 0.55);
    color: var(--accent-on-dark);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .page-hero--blueprint .eyebrow {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    letter-spacing: 0.18em;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 124px 0 52px; }
    .page-hero__sheet { display: none; }
  }
</style>
