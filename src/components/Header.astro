---
import { site, primaryNav } from '../lib/site';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---
<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="site-header__brand" aria-label={`${site.name} — Home`}>
      <Image src={logo} alt={`${site.name} logo`} width={44} height={44} loading="eager" />
      <span class="site-header__brand-text">
        <strong>Blueprint</strong> Clean Co.
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {primaryNav.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={site.phoneHref} class="site-header__phone">{site.phone}</a>
      <a href="/request-a-quote/" class="btn btn-sm btn-solid">Free Quote</a>
      <button class="site-header__burger" id="burgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobileNav" hidden>
    <ul>
      {primaryNav.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href="/request-a-quote/">Request a Quote</a></li>
    </ul>
    <a href={site.phoneHref} class="btn btn-solid" style="width:100%; margin-top:8px;">Call {site.phone}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 84px;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .site-header__brand img {
    border-radius: 6px;
  }

  .site-header__brand-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .site-header__nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-dim);
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .site-header__nav a:hover {
    color: var(--accent-bright);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }

  .site-header__phone {
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .site-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .site-header__burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    margin: 0 auto;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 16px var(--gutter) 24px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav a {
    display: block;
    padding: 12px 4px;
    font-weight: 600;
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .site-header__nav { display: none; }
    .site-header__phone { display: none; }
    .site-header__actions .btn-solid { display: none; }
    .site-header__burger { display: flex; }
    .mobile-nav.is-open { display: flex; }
  }

  @media (max-width: 420px) {
    .site-header__brand-text { font-size: 1rem; }
  }
</style>

<script>
  const burger = document.getElementById('burgerBtn');
  const nav = document.getElementById('mobileNav');
  burger?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(!!open));
    if (nav) nav.hidden = !open;
  });
</script>
