---
import { site, primaryNav } from '../lib/site';
import { Image } from 'astro:assets';
import logo from '../assets/logo-transparent.png';
import logoLight from '../assets/logo-light.png';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" id="siteHeader">
  <div class="container site-header__row">
    <a href="/" class="site-header__brand" aria-label={`${site.name}, Home`}>
      <Image src={logo} alt={`${site.name} logo`} width={130} height={130} loading="eager" class="logo-dark" />
      <Image src={logoLight} alt="" width={130} height={130} loading="eager" class="logo-light" aria-hidden="true" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {primaryNav.map((link) => (
          <li><a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={site.quoteHref} class="btn btn-sm btn-solid site-header__quote">Free Quote</a>
      <a href={site.phoneHref} class="site-header__callicon" aria-label={`Call now ${site.phone}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"/></svg>
      </a>
      <button class="site-header__burger" id="burgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobileNav" hidden>
    <ul>
      {primaryNav.map((link) => (
        <li><a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
    <div class="mobile-nav__cta">
      <a href={site.phoneHref} class="mobile-nav__btn mobile-nav__btn--call" aria-label={`Call us at ${site.phone}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"/></svg>
        Call Us
      </a>
      <a href={site.smsHref} class="mobile-nav__btn mobile-nav__btn--text" aria-label={`Text us at ${site.phone}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4 3h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 1-2Z"/></svg>
        Text Us
      </a>
      <a href={site.quoteHref} class="mobile-nav__btn mobile-nav__btn--quote">Request a Free Quote</a>
    </div>
  </div>
</header>

<style>
  /* Default is the solid white bar. It only turns transparent over a dark,
     photo-backed hero (checked in CSS so there is no flash before JS runs). */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
    --hdr-text: var(--text);
    --hdr-text-dim: var(--text-dim);
    --hdr-control-border: var(--border);
  }

  :global(body:has(#main > .bp-hero, #main > .page-hero--photo)) .site-header:not(.is-solid) {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    --hdr-text: #ffffff;
    --hdr-text-dim: rgba(255, 255, 255, 0.85);
    --hdr-control-border: rgba(255, 255, 255, 0.45);
  }

  .logo-dark {
    display: block;
  }

  .logo-light {
    display: none;
  }

  :global(body:has(#main > .bp-hero, #main > .page-hero--photo)) .site-header:not(.is-solid) .logo-dark {
    display: none;
  }

  :global(body:has(#main > .bp-hero, #main > .page-hero--photo)) .site-header:not(.is-solid) .logo-light {
    display: block;
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 140px;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--hdr-text);
  }

  .site-header__brand img {
    width: 130px;
    height: 130px;
    object-fit: contain;
  }

  .site-header__nav {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .site-header__nav ul {
    display: flex;
    justify-content: space-between;
    gap: clamp(16px, 2.2vw, 40px);
    width: 100%;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--hdr-text-dim);
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .site-header__nav a:hover {
    color: var(--hdr-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }

  .site-header__quote {
    white-space: nowrap;
  }

  .site-header__callicon {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hdr-control-border);
    border-radius: var(--radius-sm);
    color: var(--hdr-text);
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--hdr-text);
    box-shadow: 0 2px 0 var(--accent-on-dark);
  }

  .site-header.is-solid .site-header__nav a[aria-current='page'] {
    box-shadow: 0 2px 0 var(--accent);
  }

  .site-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--hdr-control-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.3s ease;
  }

  .site-header__burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--hdr-text);
    margin: 0 auto;
    transition: background-color 0.3s ease;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 16px var(--gutter) 24px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav a {
    display: block;
    padding: 12px 4px;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }

  .mobile-nav__cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 4px;
  }

  .mobile-nav .mobile-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 12px;
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .mobile-nav .mobile-nav__btn--call {
    background: var(--accent);
    color: #ffffff;
  }

  .mobile-nav .mobile-nav__btn--text {
    background: #ffffff;
    color: var(--accent);
  }

  .mobile-nav .mobile-nav__btn--quote {
    grid-column: 1 / -1;
    background: var(--accent-soft);
    color: var(--accent-bright);
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 1200px) {
    .site-header__nav { display: none; }
    .site-header__quote { display: none; }
    .site-header__callicon { display: inline-flex; }
    .site-header__burger { display: flex; }
    .mobile-nav.is-open { display: flex; }
  }

  @media (max-width: 480px) {
    .site-header__brand img { width: 72px; height: 72px; }
    .site-header__row { height: 84px; }
  }
</style>

<script>
  const header = document.getElementById('siteHeader');
  const burger = document.getElementById('burgerBtn');
  const nav = document.getElementById('mobileNav');

  burger?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(!!open));
    if (nav) nav.hidden = !open;
    if (open) header?.classList.add('is-solid');
    else updateSolidState();
  });

  // Only go transparent-over-hero when the first section is a dark, photo-backed
  // hero (.bp-hero or .page-hero--photo). Plain white PageHero variants (no image)
  // would make white header text/logo invisible, so those stay solid immediately.
  const darkHeroEl = document.querySelector('#main > .bp-hero, #main > .page-hero--photo') as HTMLElement | null;
  let threshold = -1;

  function computeThreshold() {
    if (!header || !darkHeroEl) return -1;
    return Math.max(darkHeroEl.offsetHeight - header.offsetHeight - 40, 10);
  }

  function updateSolidState() {
    if (!header) return;
    if (nav && !nav.hidden) return; // mobile menu open, stays solid
    header.classList.toggle('is-solid', threshold < 0 || window.scrollY > threshold);
  }

  threshold = computeThreshold();
  updateSolidState();

  window.addEventListener('scroll', updateSolidState, { passive: true });
  window.addEventListener('resize', () => {
    threshold = computeThreshold();
    updateSolidState();
  });
</script>
