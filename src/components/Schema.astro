---
import { site } from '../lib/site';

interface Props {
  extra?: Record<string, any>[];
}
const { extra = [] } = Astro.props;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  description:
    'Woman-owned residential and commercial cleaning for homeowners, businesses, and government facilities across Middle Tennessee, plus post-construction cleaning for builders and contractors.',
  telephone: site.phone,
  email: site.email,
  url: 'https://www.blueprintclean.com',
  image: 'https://www.blueprintclean.com/social-share.jpg',
  legalName: site.legalName,
  areaServed: site.serviceCounties.map((c) => ({ '@type': 'AdministrativeArea', name: `${c} County, TN` })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nashville',
    addressRegion: 'TN',
    addressCountry: 'US',
  },
  priceRange: '$$',
};

const schemas = [localBusiness, ...extra];
---
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
