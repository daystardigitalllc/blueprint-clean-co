---
import { site } from '../lib/site';
import { Image } from 'astro:assets';
import logo from '../assets/logo-transparent.png';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logo} alt={`${site.name} logo`} width={96} height={96} />
      <p class="site-footer__tagline">{site.subTagline}</p>
      <p class="site-footer__hours">Mon–Sat 8:00 AM–8:00 PM &middot; Sun 9:00 AM–6:00 PM</p>
      <p class="site-footer__hours">Serving {site.serviceCounties.length} Middle Tennessee counties</p>
      <p class="site-footer__hours">Proudly Woman-Owned &middot; CAGE Code Assigned</p>
    </div>

    <div>
      <h4>Services</h4>
      <ul class="site-footer__list">
        <li><a href="/residential-cleaning/">Residential Cleaning</a></li>
        <li><a href="/commercial-cleaning/">Commercial Cleaning</a></li>
        <li><a href="/post-construction-cleaning/">Post-Construction</a></li>
        <li><a href="/gallery/">Gallery</a></li>
      </ul>
    </div>

    <div>
      <h4>Company</h4>
      <ul class="site-footer__list">
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/contact/#faq">FAQ</a></li>
      </ul>
    </div>

    <div>
      <h4>Contact</h4>
      <ul class="site-footer__list">
        <li><a href={site.phoneHref}>Call {site.phone}</a></li>
        <li><a href={site.smsHref}>Text {site.phone}</a></li>
        <li><a href={site.emailHref}>{site.email}</a></li>
      </ul>
      <a href={site.quoteHref} class="btn btn-sm btn-solid" style="margin-top:14px;">Request a Free Quote</a>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {site.legalName}, operating as {site.name} All rights reserved.</p>
    <p>{site.tagline}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 72px 0 0;
    background: var(--bg-raised);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 40px;
    padding-bottom: 48px;
  }

  .site-footer__brand img {
    margin-bottom: 12px;
  }

  .site-footer__tagline {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
  }

  .site-footer__hours {
    color: var(--text-dimmer);
    font-size: 0.88rem;
    margin-bottom: 4px;
  }

  h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dimmer);
    margin-bottom: 18px;
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__list a {
    color: var(--text-dim);
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .site-footer__list a:hover {
    color: var(--accent-bright);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    color: var(--text-dimmer);
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
