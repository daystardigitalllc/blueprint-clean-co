---
import { site, primaryNav, coreServices } from '../lib/site';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logo} alt={`${site.name} logo`} width={56} height={56} />
      <p class="site-footer__tagline">{site.subTagline}</p>
      <p class="site-footer__hours">Mon–Sat 8:00 AM–6:00 PM &middot; Sun 9:00 AM–6:00 PM &middot; {site.areaServed}</p>
    </div>

    <div>
      <h4>Services</h4>
      <ul class="site-footer__list">
        {coreServices.map((s) => <li><a href={s.href}>{s.shortName}</a></li>)}
        <li><a href="/residential-commercial-cleaning/">Residential &amp; Commercial</a></li>
        <li><a href="/premium-lifestyle-services/">Premium &amp; Lifestyle</a></li>
      </ul>
    </div>

    <div>
      <h4>Company</h4>
      <ul class="site-footer__list">
        {primaryNav.filter(l => ['/about/', '/gallery/', '/reviews/', '/faq/'].includes(l.href)).map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li><a href="/request-a-quote/">Request a Quote</a></li>
      </ul>
    </div>

    <div>
      <h4>Contact</h4>
      <ul class="site-footer__list">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={site.emailHref}>{site.email}</a></li>
      </ul>
      <a href="/request-a-quote/" class="btn btn-sm btn-solid" style="margin-top:14px;">Get a Free Quote</a>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {site.name} All rights reserved.</p>
    <p>{site.tagline}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 72px 0 0;
    background: var(--bg-raised);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }

  .site-footer__brand img {
    border-radius: 8px;
    margin-bottom: 16px;
  }

  .site-footer__tagline {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
  }

  .site-footer__hours {
    color: var(--text-dimmer);
    font-size: 0.88rem;
  }

  h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dimmer);
    margin-bottom: 18px;
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__list a {
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .site-footer__list a:hover {
    color: var(--accent-bright);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    color: var(--text-dimmer);
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
