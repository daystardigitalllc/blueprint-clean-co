---
import { Image } from 'astro:assets';
import { coreServices } from '../lib/site';
import featuredImg from '../assets/photos/hero-kitchen-marble.png';
---
<div class="service-bento">
  {coreServices.map((s) => (
    <a href={s.href} class:list={['service-card', { 'service-card--featured': s.featured }]}>
      {s.featured && (
        <div class="service-card__bg">
          <Image src={featuredImg} alt="" role="presentation" width={900} height={900} class="graded-img" />
        </div>
      )}
      <span class="service-card__audience">{s.audience}</span>
      <h3>{s.name}</h3>
      <p>{s.summary}</p>
      <span class="service-card__link">Learn more &rarr;</span>
    </a>
  ))}
</div>

<style>
  .service-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, auto);
    gap: 20px;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    grid-column: span 2;
    padding: 28px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-card);
    min-height: 210px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(11,14,18,0.06);
  }

  .service-card--featured {
    grid-column: span 2;
    grid-row: span 2;
    min-height: 440px;
    border-color: #14141a;
    overflow: hidden;
  }

  .service-card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .service-card__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-card--featured::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6,10,16,0.35) 0%, rgba(6,10,16,0.86) 78%);
  }

  .service-card--featured > *:not(.service-card__bg) {
    position: relative;
    z-index: 2;
  }

  .service-card--featured .service-card__audience,
  .service-card--featured .service-card__link {
    color: var(--accent-on-dark);
  }

  .service-card--featured h3,
  .service-card--featured p {
    color: #ffffff;
  }

  .service-card--featured h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
  }

  .service-card__audience {
    display: inline-block;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .service-card p {
    color: var(--text-dim);
    font-size: 0.94rem;
    margin-bottom: 16px;
  }

  .service-card__link {
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .service-bento { grid-template-columns: repeat(2, 1fr); }
    .service-card, .service-card--featured { grid-column: span 2; grid-row: span 1; min-height: 240px; }
  }

  @media (max-width: 620px) {
    .service-bento { grid-template-columns: 1fr; }
    .service-card, .service-card--featured { grid-column: span 1; }
  }
</style>
