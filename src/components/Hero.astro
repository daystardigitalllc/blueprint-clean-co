---
import { Image } from 'astro:assets';
import { site } from '../lib/site';
import heroImg from '../assets/photos/hero-kitchen-marble.png';

const typeWords = [
  'Post-Construction New Builds',
  'Pre-Listing Realtor Prep',
  'Move-In / Move-Out Turnovers',
  'Airbnb Turnovers',
  'Recurring Residential & Commercial',
];
---
<section class="hero">
  <div class="hero__text">
    <div class="hero__text-inner">
      <p class="hero__type" aria-hidden="true">
        <span>Experts in </span><span class="hero__type-text" id="heroType">{typeWords[0]}</span><span class="hero__type-caret"></span>
      </p>
      <span class="sr-only">
        Experts in post-construction cleaning, pre-listing realtor prep, move-in/move-out turnovers, Airbnb turnovers, and recurring residential &amp; commercial cleaning.
      </span>

      <h1>Precision Cleaning. <span class="accent">Professional Results.</span></h1>
      <p class="lede hero__sub">
        Blueprint Clean Co. is Nashville's go-to cleaning partner for realtors, property managers, home builders, and Airbnb hosts — plus the recurring residential &amp; commercial teams to keep any space pristine.
      </p>

      <div class="btn-row">
        <a href="/request-a-quote/" class="btn btn-solid">Get a Free Quote</a>
        <a href={site.phoneHref} class="btn">Call {site.phone}</a>
      </div>

      <ul class="hero__trust">
        <li>Post-Construction Specialists</li>
        <li>Trusted by Realtors &amp; PMs</li>
        <li>Free Estimates</li>
      </ul>
    </div>
  </div>

  <div class="hero__media">
    <Image src={heroImg} alt="Pristine, freshly cleaned kitchen" width={1200} height={1400} loading="eager" fetchpriority="high" class="graded-img" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
  }

  .hero__text {
    display: flex;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 56px;
    padding-right: 48px;
    padding-left: clamp(24px, 5vw, 80px);
  }

  .hero__text-inner {
    max-width: 560px;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    min-height: 320px;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__type {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
    min-height: 1.4em;
  }

  .hero__type-caret {
    display: inline-block;
    width: 2px;
    height: 0.9em;
    background: var(--accent);
    margin-left: 3px;
    vertical-align: -0.1em;
    animation: caret 0.9s steps(1) infinite;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .hero h1 {
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
    letter-spacing: -0.01em;
  }

  .hero__sub {
    margin-top: 18px;
    margin-bottom: 28px;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 26px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__trust li {
    position: relative;
    padding-left: 18px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-dim);
  }

  .hero__trust li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__media {
      min-height: 280px;
      order: -1;
    }
    .hero__text {
      padding: 40px 24px 48px;
    }
  }

  @media (max-width: 560px) {
    .hero__trust { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>

<script define:vars={{ typeWords }}>
  const el = document.getElementById('heroType');
  if (el) {
    let wordIndex = 0;
    let charIndex = typeWords[0].length;
    let deleting = false;

    function tick() {
      const word = typeWords[wordIndex];
      if (!deleting) {
        charIndex++;
        if (charIndex > word.length) {
          deleting = true;
          setTimeout(tick, 1600);
          return;
        }
      } else {
        charIndex--;
        if (charIndex < 0) {
          deleting = false;
          wordIndex = (wordIndex + 1) % typeWords.length;
          el.textContent = '';
          setTimeout(tick, 300);
          return;
        }
      }
      el.textContent = word.slice(0, charIndex);
      setTimeout(tick, deleting ? 35 : 65);
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = typeWords[0];
      setTimeout(tick, 1600);
    }
  }
</script>
